<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.accounting.app.controller.MainController" prefHeight="600.0" prefWidth="800.0"
      style="-fx-background-color: #f4f4f4;">
    <Label text="Accounting App" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="36.0" />
        </font>
    </Label>
    <Label fx:id="welcomeText" text="Loading..." textFill="#7f8c8d">
        <font>
            <Font size="18.0" />
        </font>
    </Label>
</VBox>
